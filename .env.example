# OpenAI-compatible LLM endpoint.
# Local Ollama default: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
# Optional role-specific overrides. Leave blank to use LLM_MODEL.
LLM_SCOUT_MODEL=
LLM_PRODUCER_MODEL=
LLM_FACT_CHECKER_MODEL=
LLM_VISUAL_PRODUCER_MODEL=
LLM_VISUAL_MODEL=
# Leave blank for local Ollama. Set for hosted providers.
LLM_API_KEY=

# FAL.ai — image generation
FAL_KEY=
FAL_REFERENCE_MODEL=fal-ai/flux-2-pro/edit
FAL_CONCEPT_MODEL=fal-ai/flux-2-pro

# Cloudinary — stable public image buffer
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Meta Graph API — long-lived Instagram publishing token
META_GRAPH_TOKEN=
META_IG_ACCOUNT_ID=

# Slack App — interactive approval gateway
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# Private reference workflow
REFERENCE_TIMEOUT_MINUTES=30
REFERENCE_DB_PATH=./reference-workflow.db

# Verified official player-reference discovery
BRAVE_SEARCH_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REFERENCE_FACE_SIMILARITY_THRESHOLD=95

# Timezone for cron (UK time)
TZ=Europe/London

# Express webhook port (default: 4242 — avoids conflicts with other local servers)
WEBHOOK_PORT=4242
